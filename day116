/* Structure of binary tree node
class Node{
    int data;
    Node left, right;

    Node(int item)
    {
        data = item;
        left = right = null;
    }
}
*/

class Solution {
    
    void dfs(Node root, int hd, TreeMap<Integer, Integer> map) {
        if (root == null) return;

        // Add current node value to its vertical line sum
        map.put(hd, map.getOrDefault(hd, 0) + root.data);

        // Traverse left and right
        dfs(root.left, hd - 1, map);
        dfs(root.right, hd + 1, map);
    }

    public ArrayList<Integer> verticalSum(Node root) {
        
        TreeMap<Integer, Integer> map = new TreeMap<>();
        
        dfs(root, 0, map);

        ArrayList<Integer> ans = new ArrayList<>();

        for (int sum : map.values()) {
            ans.add(sum);
        }

        return ans;
    }
}
