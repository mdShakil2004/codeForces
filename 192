class Solution {
    public int minCost(int[][] mat) {
        int n = mat.length;

        // dp[j] = minimum cost up to the current row
        // if choice j is selected in the current row.
        int[] dp = new int[3];

        // First row
        for (int j = 0; j < 3; j++) {
            dp[j] = mat[0][j];
        }

        // Process remaining rows
        for (int i = 1; i < n; i++) {
            int[] next = new int[3];

            next[0] = mat[i][0] + Math.min(dp[1], dp[2]);
            next[1] = mat[i][1] + Math.min(dp[0], dp[2]);
            next[2] = mat[i][2] + Math.min(dp[0], dp[1]);

            dp = next;
        }

        return Math.min(dp[0], Math.min(dp[1], dp[2]));
    }
}
