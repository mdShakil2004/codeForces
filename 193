class Solution {
    public int editDistance(String s1, String s2) {
        int m = s1.length();
        int n = s2.length();

        int[] dp = new int[n + 1];

        // Convert empty s1 to s2
        for (int j = 0; j <= n; j++) {
            dp[j] = j;
        }

        for (int i = 1; i <= m; i++) {
            int prev = dp[0];

            // Convert first i characters of s1 to empty string
            dp[0] = i;

            for (int j = 1; j <= n; j++) {
                int temp = dp[j];

                if (s1.charAt(i - 1) == s2.charAt(j - 1)) {
                    dp[j] = prev;
                } else {
                    // Delete, Insert, Replace
                    dp[j] = 1 + Math.min(
                        prev,                    // Replace
                        Math.min(dp[j], dp[j - 1]) // Delete, Insert
                    );
                }

                prev = temp;
            }
        }

        return dp[n];
    }
}
