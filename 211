211import java.util.*;

class Solution {
    public int minimumEdgeReversal(int[][] edges, int n, int src, int dst) {
        
        // adj[u] = {neighbor, cost}
        List<int[][]> adj = new ArrayList<>();
        
        for (int i = 0; i <= n; i++) {
            adj.add(new int[0][0]);
        }

        // Easier representation using lists
        List<List<int[]>> graph = new ArrayList<>();
        for (int i = 0; i <= n; i++) {
            graph.add(new ArrayList<>());
        }

        for (int[] edge : edges) {
            int u = edge[0];
            int v = edge[1];

            // Original direction: no reversal needed
            graph.get(u).add(new int[]{v, 0});

            // Reverse direction: one reversal needed
            graph.get(v).add(new int[]{u, 1});
        }

        int INF = Integer.MAX_VALUE;
        int[] dist = new int[n + 1];
        Arrays.fill(dist, INF);

        Deque<Integer> deque = new ArrayDeque<>();

        dist[src] = 0;
        deque.offerFirst(src);

        while (!deque.isEmpty()) {
            int u = deque.pollFirst();

            for (int[] edge : graph.get(u)) {
                int v = edge[0];
                int cost = edge[1];

                if (dist[u] != INF && dist[u] + cost < dist[v]) {
                    dist[v] = dist[u] + cost;

                    if (cost == 0) {
                        deque.offerFirst(v);
                    } else {
                        deque.offerLast(v);
                    }
                }
            }
        }

        return dist[dst] == INF ? -1 : dist[dst];
    }
}
