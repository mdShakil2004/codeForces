class Solution {
    static final long MOD = 1000000007L;

    public int prefixStrings(int n) {
        long fact2n = 1;
        long factN = 1;

        // Calculate (2n)! and n!
        for (int i = 1; i <= 2 * n; i++) {
            fact2n = (fact2n * i) % MOD;

            if (i <= n) {
                factN = (factN * i) % MOD;
            }
        }

        // Catalan = (2n)! / (n! * n! * (n+1))
        long denominator = (factN * factN) % MOD;
        denominator = (denominator * (n + 1)) % MOD;

        long inverse = modPow(denominator, MOD - 2);

        return (int) ((fact2n * inverse) % MOD);
    }

    private long modPow(long a, long b) {
        long result = 1;

        while (b > 0) {
            if ((b & 1) == 1) {
                result = (result * a) % MOD;
            }

            a = (a * a) % MOD;
            b >>= 1;
        }

        return result;
    }
}
